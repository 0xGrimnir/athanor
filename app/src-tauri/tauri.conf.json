{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athanor",
  "version": "0.2.5",
  "identifier": "org.athanor.workbench",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Athanor",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#03070b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Tyler Lee Jones",
    "copyright": "Copyright (c) 2026 Tyler Lee Jones",
    "category": "Education",
    "shortDescription": "Desktop science workbench",
    "longDescription": "Athanor runs real computational chemistry (MMFF94, GFN2-xTB, DFT) with every result validated against published data and labeled with its method and limits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNkY2OTAwM0Q0NjFENDUKUldSRkhVWTlBR2x2WVlWOHQ3SjdpYkM1R0F5SE9JQzFxTVQ4b0tGUUMydzhuYTZ3bHpSYnZoSGIK",
      "endpoints": [
        "https://github.com/0xGrimnir/athanor-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
