# Normalize line endings: LF in the repo, native on checkout
* text=auto eol=lf

# Windows scripts need CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.wasm binary
*.exe binary
*.msi binary
*.zip binary
*.gz binary
*.pdb binary
