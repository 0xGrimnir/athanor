  "NISTtriatomic": "NIST Triatomic Spectral Database (SRD 117), as compiled in CCCBDB-R22.",
  "Viswanathan1984": "CCCBDB key 1984Vis/Dyk:231-239 (H2S dipole), as compiled in CCCBDB-R22.",
  "Janoschek2001": "R. Janoschek, Quantum chemical B3LYP/cc-pvqz computation of ground-state structures and properties of small molecules with atoms of Z <= 18 (IUPAC Technical Report), Pure Appl. Chem. 73, 1521-1553 (2001). DOI: 10.1351/pac200173091521",
  "HaitHeadGordon2018": "D. Hait, M. Head-Gordon, How accurate is density functional theory at predicting dipole moments? An assessment using a new database of 200 benchmark values, J. Chem. Theory Comput. (2018). arXiv:1709.05075",
  "CompositeIR2024": "Efficient Composite Infrared Spectroscopy: Combining the Doubly-Harmonic Approximation with Machine Learning Potentials, arXiv:2408.08174 (2024), Table S3 (MHG114 subset vs CCSD(T)/CBS).",
  "Kouam2025": "Teguia Kouam et al., Comparative analysis of GFN methods in geometry optimization of small organic semiconductor molecules: A DFT benchmarking study, arXiv:2505.09606 (2025).",
  "MMFF94-suite": "MMFF94 validation suite (T. A. Halgren), 761 molecules with reference energies; distributed via CCL (ccl.net/cca/data/MMFF94) and in RDKit's test data (Code/ForceField/MMFF/test_data)."
 },
